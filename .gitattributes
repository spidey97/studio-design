# Normalise line endings; Windows helper scripts keep CRLF
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never diff or convert
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp4 binary

# Generated / vendored code: keep out of language stats and diffs
js/vendor/** linguist-vendored -diff
